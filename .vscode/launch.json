{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CSLICS Client Vision Processor",
            "type": "debugpy",
            "request": "launch",
            "module": "cslics_vision_processor.client_vision_processor",
            "args": ["192.168.1.10", "1883",
                "~/cslics_config/models/microsphere_m12_dataset_640p_yolov8m.pt",
                "--image-source", "PICAM",
                "--config_file_path", "~/cslics_config/camera_config_seasim_rm9_2024.json",
		        "--persist_path", "~/cslics_config/persist", 
                "--process_conf_path", "~/cslics_config/camera_process_config.json"
            ]
        },
        {
            "name": "Simulate Camera",
            "type": "debugpy",
            "request": "launch",
            "module": "cslics_vision_processor.client_vision_processor",
            "args": ["localhost", "1883",
                "~/cslics/models/microsphere_m12_dataset_640p_yolov8m.pt",
                "-id", "E814DB1D941EBC26",
                "--image-source", "STORAGE_LOCAL",
                "--image-directory", "~/cslics/images/microsphere_m12_dataset/train/",
                "--config_file_path", "~/cslics_ref/cslics_ref_raas_vision_processor/config/camera_config_seasim_2023.json",
		        "--persist_path", "~/cslics_ref/cslics_ref_raas_vision_processor/config/persist", 
                "--process_conf_path", "~/cslics_ref/cslics_ref_raas_vision_processor/config/camera_process_config.json"
            ]
        }
        {
            "name": "Simulate Cameras",
            "type": "debugpy",
            "request": "launch",
            "module": "cslics_vision_processor.testing.simulate_cameras",
            "args": ["localhost", "1883",
                "~/cslics/models/microsphere_m12_dataset_640p_yolov8m.pt",
                "--image-source", "STORAGE_LOCAL",
                "--image-directory", "~/cslics/images/microsphere_m12_dataset/train/",
                "--config_file_path", "~/cslics_ref/cslics_ref_raas_vision_processor/config/camera_config_seasim_2023.json",
		        "--persist_path", "~/cslics_ref/cslics_ref_raas_vision_processor/config/persist", 
                "--process_conf_path", "~/cslics_ref/cslics_ref_raas_vision_processor/config/camera_process_config.json"
            ]
        }
    ]
}
